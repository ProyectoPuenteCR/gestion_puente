# Google Sheets (lectura y escritura en Integrantes, Configuracion, Usuarios, Baja y LOG)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Recomendado: guardar el private_key completo del JSON codificado en Base64.
GOOGLE_PRIVATE_KEY_BASE64=

# Opcional. Si se omite, se busca o crea una carpeta de Drive llamada "fotos".
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=

# Alternativa: clave PEM con saltos de línea escapados como \n.
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Inicio de sesión con Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cumpleaños automáticos (09:00 de Argentina mediante Vercel Cron)
RESEND_API_KEY=
BIRTHDAY_FROM_EMAIL="Proyecto Puente <cumpleanios@proyecto-puente.org>"
CRON_SECRET=

# Cadena aleatoria para cifrar y firmar las sesiones. Ejemplo: openssl rand -base64 48
AUTH_SECRET=

# Restricción institucional y administradores (varios correos separados por comas)
AUTH_ALLOWED_DOMAIN=proyecto-puente.org
AUTH_ADMIN_EMAILS=brechasdigitales@proyecto-puente.org
